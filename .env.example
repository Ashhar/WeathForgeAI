# Supabase project credentials — copy to .env (never commit .env).
# The anon key is safe for the client bundle because Row Level Security
# is enabled on every user-data table (see supabase/migrations).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Client-side (AI-powered import) ----
# Used by js/ai-import.js for LLM extraction from CAS PDFs:
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- Server-side only (GitHub Actions secrets — NEVER put these in .env
# with a VITE_ prefix; VITE_ vars are baked into the public client bundle) ----
# Used by .github/workflows/market-data-sync.yml → scripts/sync-rates.mjs:
#   SUPABASE_URL              = https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY = service-role key (Dashboard → Settings → API)
#   METALS_API_KEY            = optional metals.dev key for INR-native gold/silver;
#                               without it the job falls back to keyless spot
#                               providers (gold-api.com + open.er-api.com).
