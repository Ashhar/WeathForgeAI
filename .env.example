# Supabase project credentials — copy to .env (never commit .env).
# The anon key is safe for the client bundle because Row Level Security
# is enabled on every user-data table (see supabase/migrations).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
